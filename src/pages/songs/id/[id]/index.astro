---
import { Show } from 'solid-js';

import Layout from '~/layouts/base.astro';
import { songs } from '~/services/db.ts';
import { Button, LinkButton } from '~/components/elements/button';

const id = Astro.params.id!;

const data = await songs.findOne(id);
if (!data) {
	return new Response(null, { status: 404 });
}
---

<Layout title={data.title + " | Songs"}>
	<article class="prose | flow">
		<div class="l-repel" style='--repel-align: center;'>
			<h1>{data.title}</h1>

			<Show when={Astro.locals.user}>
				<div class="l-cluster">
					<LinkButton variant="text" href={'/songs/id/' + data.id + '/edit'}>Edit</LinkButton>
					<form method="post" action={'/songs/id/' + data.id + '/delete'} name='delete'>
						<Button type="submit" color='danger' variant="text">Delete</Button>
					</form>
					<script>
						const form = document.forms.namedItem('delete');

						if (form) {
							form.addEventListener('submit', (ev) => {
								ev.preventDefault();

								const res = window.confirm('Once you delete this item, you cannot retrieve it. Are you sure you want to delete it?');

								if (res) {
									form.submit();
								}
							});
						}
					</script>
				</div>
			</Show>
		</div>

		<pre>{data.content}</pre>
	</article>
</Layout>
