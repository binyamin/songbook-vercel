---
import { safeParse } from 'valibot';

import Layout from '~/layouts/base.astro';
import { SongForm } from '~/components/ui/song-form';

import { songs } from '~/services/db.ts';
import { formatIssues, formToJSON } from '~/services/helpers.ts';

if (!Astro.locals.user) {
	return new Response("Unauthorized", {
		status: 401,
	});
}

const id = Astro.params.id!;

let errors: Partial<ReturnType<typeof formatIssues>> = {}

const data = await songs.findOne(id);

if (!data) {
	return new Response(null, { status: 404 });
}

if (Astro.request.method === 'POST') {
	const input = formToJSON(await Astro.request.formData());

	const res = safeParse(songs.inputSchema, input);

	if (res.success) {
		const data = await songs.update(id, res.output);

		return Astro.redirect('/songs/id/' + data.id, 303);
	}

	errors = formatIssues(res.issues);
}
---

<Layout title={`Editing "${data.title}" | Songs`}>
	<article class="prose | flow">
		<h1>Editing <b>{data.title}</b></h1>

		<SongForm type="edit" errors={errors} input={data} cancelUrl={'/songs/id/' + data.id} />
	</article>
</Layout>
