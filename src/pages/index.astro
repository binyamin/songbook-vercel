---
import Layout from '~/layouts/base.astro';
import { site } from '~/const';

const user = Astro.locals.user;
---

<Layout title={false}>
	<article class="prose | flow">
		<h1>{ site.title }</h1>

		{user
			? <p><b>Username</b>: <var>{user.username}</var></p>
			: <p>You are <em>not</em> logged in. You can still browse <a href="/songs">existing songs</a>.</p>
		}
	</article>
</Layout>
