---
import '~/css/style.css';
import './base.css';

import { Button } from '~/components/elements/button';

export interface Props {
	title: string | false;
}

const docTitle = (Astro.props.title ? Astro.props.title + ' | ' : '') + 'Songbook';
const session = await Astro.locals.auth.validate();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{docTitle}</title>
	</head>
	<body>
		<div id="root" class="l-gelati | flow">
			<nav class="l-repel">
				<a href="/">Home</a>
				<ul role="list" class="l-cluster">
					<li><a href="/songs">Songs</a></li>
					{session && <li><a href="/songs/new">New Song</a></li>}
					<li>{session
						? <form method="POST" action="/log-out" name="logout">
							<Button type="submit" color='danger' variant="soft">Log out</Button>
						</form>
						: <a href="/log-in">Log in</a>
					}</li>
				</ul>
			</nav>
			<script>
				const form = document.forms.namedItem('logout');

				if (form) {
					form.addEventListener('submit', (ev) => {
						ev.preventDefault();

						const res = window.confirm('Are you sure you want to log out?');

						if (res) {
							form.submit();
						}
					});
				}
			</script>
			<main>
				<slot />
			</main>
			<footer class="l-center">
				<p>Made with love by Binyamin Green</p>
			</footer>
		</div>
	</body>
</html>
