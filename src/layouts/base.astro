---
import '~/css/style.css';
import './base.css';

import { Show } from 'solid-js';

import { site } from '~/const';
import { Button } from '~/components/elements/button';

export interface Props {
	title: string | false;
}

const docTitle = (Astro.props.title ? Astro.props.title + ' | ' : '') + site.title;
const user = Astro.locals.user;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{docTitle}</title>
	</head>
	<body>
		<div id="root" class="l-gelati | flow">
			<nav class="site-header | l-repel">
				<a href="/" class="logo" aria-label="Home">{site.title}</a>
				<ul role="list" class="l-cluster">
					<li><a href="/songs">Songs</a></li>
					<Show when={user} >
						<li><a href="/songs/new">New Song</a></li>
						<li><form method="POST" action="/log-out" name="logout">
							<Button type="submit" color='danger' variant="soft">Log out</Button>
						</form></li>
					</Show>
					<Show when={!user}>
						<li><a href="/log-in">Log in</a></li>
					</Show>
				</ul>
			</nav>
			<Show when={user}>
				<script>
					const form = document.forms.namedItem('logout');

					if (form) {
						form.addEventListener('submit', (ev) => {
							ev.preventDefault();

							const res = window.confirm('Are you sure you want to log out?');

							if (res) {
								form.submit();
							}
						});
					}
				</script>
			</Show>
			<main>
				<slot />
			</main>
			<footer class="l-center">
				<p>Made with love by Binyamin Green</p>
			</footer>
		</div>
	</body>
</html>
